@startautofac
title 15 - External clock and an explicitly empty collection

object "clock : FixedClock (external)" as clock
lifetime "System" as system {
	register clockBinding: IClock instance clock ownership external
}
create system

event time on system : Resolve IClock
clock --> system : returns clock
time ..> system.clockBinding

event plugins on system : Resolve IEnumerable<IPlugin>
object "plugins : IPlugin[0]" as pluginArray ownedBy system
create pluginArray
pluginArray --> system : [] (zero plugins)

destroy pluginArray
destroy system
@endautofac
