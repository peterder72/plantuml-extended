@startautofac
title 13 - A parent end does not destroy its child

lifetime "System" as system
create system
lifetime "Request" as request from system {
	register worker: IWorker -> Worker sharing perScope
}
create request
object "worker1 : Worker" as worker1 ownedBy request

destroy system

event continuing on request : Resolve IWorker after parent disposal
create worker1
worker1 --> request : returns worker1
continuing ..> request.worker

destroy worker1
destroy request
event tooLate on request marker cross : Resolve attempted after request disposal
@endautofac
