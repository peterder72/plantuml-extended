---
output: svg
expected-description: (Autofac lifetime)
---
@startautofac
title Module-provisioned request

module RequestModule {
	register foo: IFoo -> Foo sharing perScope
	register fast: ICache key "fast" -> FastCache
	register slow: ICache key "slow" -> SlowCache
	register client: IClient via delegate "createClient(ctx)"
	decorate IFoo with LoggingFoo
	decorate IFoo with MetricsFoo
}
lifetime "System" as system {
	register bar: IBar -> Bar sharing single
	register moduleRegistration: RequestModule -> RequestModule sharing single
}
create system
object "module1 : RequestModule" as module1 ownedBy system
event moduleRequest on system : Resolve RequestModule
create module1
module1 --> system : returns module1
moduleRequest ..> system.moduleRegistration

lifetime "Request" as request from system tag "request" {
	install module1 as RequestModule
}
create request
object "foo : Foo" as foo ownedBy request
object "logging : LoggingFoo" as logging ownedBy request
object "metrics : MetricsFoo" as metrics ownedBy request
object "bar : Bar" as bar ownedBy system
object "fast : FastCache" as fast ownedBy request
participant "Client factory" as factory

event fooRequest on request : Resolve IFoo
create foo
create logging
create metrics
metrics --> request : returns metrics
fooRequest ..> request.module1.foo
metrics ..> logging : wraps
logging ..> foo : wraps

event barFirst on request : Resolve IBar
request -> system : Activate IBar
create bar
bar --> request : returns bar
barFirst ..> system.bar
event barAgain on request : Resolve IBar again
bar --> request : same bar
barAgain ..> bar : references

event fastRequest on request : Resolve ICache key "fast"
create fast
fast --> request : returns fast
fastRequest ..> request.module1.fast

event clientRequest on request : Resolve IClient
request -> factory : Execute createClient(ctx)
factory -> request : Resolve IConnection
event on request marker cross : IConnection is not registered
request --> factory : Dependency lookup failed
factory --> request : IClient activation failed
clientRequest ..> request.module1.client
event missingKey on request marker cross : No ICache for key "archive"

event on request : Dispose request
destroy fast
destroy metrics
destroy logging
destroy foo
destroy request
@endautofac
