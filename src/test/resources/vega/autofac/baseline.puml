expected-description: (Autofac lifetime)
---
@startautofac
title Root and request

lifetime "System" as system {
	register clock: IClock -> Clock sharing single
}
create system
lifetime "Request" as request from system {
	register worker: IWorker -> Worker sharing perScope
}
create request

event first on request : Resolve IWorker
event second on request : Resolve IClock
event on request : Dispose request
destroy request
@endautofac
