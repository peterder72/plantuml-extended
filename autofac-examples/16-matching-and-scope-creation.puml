@startautofac
title 16 - Missing matching tag and rejected construction
<style>
autofacDiagram {
	FontSize 16
	autofacConstruction {
		LineThickness 2
	}
}
</style>

lifetime "System" as system {
	register session: ISession -> Session sharing matching("request")
}
create system
lifetime "Untagged request" as untagged from system
create untagged

event session on untagged marker cross : No matching lifetime tagged "request"
session ..> system.session
destroy untagged

lifetime "Rejected request" as rejected from system tag "request" {
	register worker: IWorker -> Worker
}
event rejectedBuild on system marker cross : ConfigurationException from construction callback
rejectedBuild ..> rejected : construction rejected
note over rejected : Configuration attempted; this lifetime was never created
@endautofac
