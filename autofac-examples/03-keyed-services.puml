@startautofac
title 03 - Keyed caches and arbitrary request labels

lifetime "System" as system {
	register fast: ICache key "fast" -> MemoryCache sharing single
	register durable: ICache name "durable" -> DiskCache sharing single
}
create system
object "memory : MemoryCache" as memory ownedBy system
object "disk : DiskCache" as disk ownedBy system
lifetime "Request" as request from system
create request

event quick on request : Resolve ICache key "fast"
create memory
memory --> request : returns memory
quick ..> system.fast

event safe on request : Resolve ICache name "durable"
create disk
disk --> request : returns disk
safe ..> system.durable

event archive on request marker cross : No cache for key "archive"
event refresh on request marker diamond : Refresh dashboard tiles
request -> memory : Read dashboard
memory --> request : cached tiles
event retry on request : Retry fast-cache lookup
memory --> request : same memory
event checkpoint on request marker square : Commit checkpoint #7
request -> disk : Flush checkpoint
disk --> request : durable acknowledgement

destroy request
@endautofac
