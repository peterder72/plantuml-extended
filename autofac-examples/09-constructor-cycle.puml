@startautofac
composition "Constructor cycle: declared activation failure" {
	' Dependency descriptions do not execute constructors or infer a failure.
	lifetime system root {
		register orders: IOrders -> Orders sharing perScope
		register stock: IStock -> Stock sharing perScope
		depends Orders { stock: IStock via ctor }
		depends Stock { orders: IOrders via ctor }
	}
	resolve start: IOrders from system
	' The author declares both the failed activation and its finite cycle.
	expect start failure constructorCycle {
		selected system.orders
		activation system
		path IOrders -> Orders -> Stock
		cycle Orders -> Stock -> Orders
		cause "Constructor dependencies require each other"
		confidence declared
	}
	dispose system
	view diagnostics
}
@endautofac
