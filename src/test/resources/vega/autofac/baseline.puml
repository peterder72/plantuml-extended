---
output: svg
expected-description: (Autofac lifetime)
---
@startautofac
composition "Root and request" {
  lifetime system root {
    register clock: IClock -> Clock sharing single
  }
  lifetime request from system {
    register worker: IWorker -> Worker sharing perScope
  }
  resolve first: IWorker from request
  resolve second: IClock from request
  dispose request
}
@endautofac
