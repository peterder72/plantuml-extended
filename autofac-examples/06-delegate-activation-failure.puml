@startautofac
title 06 - A factory is found; its dependency request fails

lifetime "System" as system
create system
lifetime "Request" as request from system {
	register client: IClient via delegate "createClient(ctx)" sharing transient ownership scope
}
create request
participant "Client factory" as factory

event client on request : Resolve IClient
request -> factory : Execute createClient(ctx)
factory -> request : Resolve IConnection
event missing on request marker cross : IConnection is not registered
request --> factory : Dependency lookup failed
factory --> request : IClient activation failed
client ..> request.client

destroy request
@endautofac
