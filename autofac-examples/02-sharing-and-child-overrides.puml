@startautofac
title 02 - Local override and one root-owned clock

lifetime "System" as system {
	register clock: IClock -> SystemClock sharing single
	register logger: ILogger -> ConsoleLogger sharing single
}
create system
object "console : ConsoleLogger" as console ownedBy system
object "sharedClock : SystemClock" as sharedClock ownedBy system

event rootLog on system : Resolve ILogger
create console
console --> system : returns console
rootLog ..> system.logger

lifetime "Request A" as requestA from system {
	register logger: ILogger -> RequestLogger sharing perScope
}
create requestA
object "requestLog : RequestLogger" as requestLog ownedBy requestA
event localLog on requestA : Resolve ILogger
create requestLog
requestLog --> requestA : returns requestLog
localLog ..> requestA.logger

event clockA on requestA : Resolve IClock
requestA -> system : Activate IClock
event clockLog on system : Resolve ILogger for clock construction
console --> system : same console
clockLog ..> system.logger
create sharedClock
sharedClock --> requestA : returns sharedClock
clockA ..> system.clock

destroy requestLog
destroy requestA

lifetime "Request B" as requestB from system
create requestB
event clockB on requestB : Resolve IClock
sharedClock --> requestB : returns same sharedClock
clockB ..> sharedClock : references
destroy requestB
@endautofac
