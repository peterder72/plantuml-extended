@startautofac
title 12 - Independent sibling requests in native branches

lifetime "System" as system {
	register worker: IWorker -> Worker sharing perScope
}
create system
lifetime "Left request" as left from system
lifetime "Right request" as right from system
object "leftWorker : Worker" as leftWorker ownedBy left
object "rightWorker : Worker" as rightWorker ownedBy right

par Left request
	create left
	event leftWork on left : Resolve IWorker
	create leftWorker
	leftWorker --> left : leftWorker
else Right request
	create right
	event rightWork on right : Resolve IWorker
	create rightWorker
	rightWorker --> right : rightWorker
end
leftWork ..> system.worker
rightWork ..> system.worker

destroy leftWorker
destroy left
destroy rightWorker
destroy right
destroy system
@endautofac
