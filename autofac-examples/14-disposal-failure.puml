@startautofac
title 14 - A failed disposal attempt is not destruction

lifetime "System" as system
create system
lifetime "Request" as request from system {
	register connection: IConnection -> Connection ownership scope
}
create request
object "connection1 : Connection" as connection1 ownedBy request

event open on request : Resolve IConnection
create connection1
connection1 --> request : returns connection1
open ..> request.connection

event close on request : Attempt request disposal
request -> connection1 : Dispose()
connection1 --> request : InvalidOperationException
event failed on request marker cross : Cleanup did not complete
note over request : Post-failure usability is not asserted
@endautofac
