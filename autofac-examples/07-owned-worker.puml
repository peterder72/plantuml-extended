@startautofac
title 07 - Caller-controlled Owned worker lifetime

lifetime "System" as system
create system
lifetime "Request" as request from system {
	register worker: IWorker -> Worker sharing transient ownership scope
}
create request
object "owned : Owned<IWorker>" as owned

event acquire on request : Resolve Owned<IWorker>
create owned
lifetime "Worker scope" as workerScope from request ownedBy owned
create workerScope
object "worker1 : Worker" as worker1 ownedBy workerScope
request -> workerScope : Resolve IWorker
create worker1
worker1 --> owned : returns worker1
owned --> request : returns owned
acquire ..> request.worker
owned ..> worker1 : Value

request -> owned : Dispose owned
owned -> workerScope : Dispose child lifetime
destroy worker1
destroy workerScope
destroy owned
destroy request
@endautofac
