@startautofac
title 11 - Explicit cross-scope factory re-entry

lifetime "System" as system {
	register risky: IFoo via delegate "ctx => request.Resolve<IFoo>()" sharing single
}
create system
lifetime "Request" as request from system
create request

event trigger on request : Resolve IFoo
request -> system : Invoke risky
loop while the factory re-enters
	system -> request : Resolve IFoo
	request -> system : Invoke risky
end
trigger ..> system.risky
@endautofac
