@startautofac
title 08 - Deferred calls return explicitly identified objects

lifetime "System" as system
create system
lifetime "Request" as request from system {
	register worker: IWorker -> Worker sharing perScope ownership scope
	register report: IReport -> Report sharing perScope ownership scope
}
create request
object "factory : Func<IWorker>" as factory ownedBy request
object "worker1 : Worker" as worker1 ownedBy request
object "lazy : Lazy<IReport>" as lazy ownedBy request
object "report1 : Report" as report1 ownedBy request

event on request : Acquire Func<IWorker>
create factory
factory --> request : returns factory

event first on request : First deferred call
request -> factory : Invoke factory()
create worker1
worker1 --> factory : returns worker1
factory --> request : returns worker1
first ..> request.worker

event second on request : Second deferred call
request -> factory : Invoke factory()
worker1 --> factory : returns same worker1
factory --> request : returns same worker1
second ..> worker1 : references

event on request : Acquire Lazy<IReport>
create lazy
lazy --> request : returns lazy
event value on request : Read deferred value
request -> lazy : Read Value
create report1
report1 --> lazy : returns report1
lazy --> request : returns report1
value ..> request.report

destroy report1
destroy lazy
destroy worker1
destroy factory
destroy request
@endautofac
