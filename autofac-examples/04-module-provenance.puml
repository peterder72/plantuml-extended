@startautofac
title 04 - A real module object supplies request construction

module OrdersModule {
	register orders: IOrders -> Orders sharing perScope ownership scope
}
lifetime "System" as system {
	register module: OrdersModule -> OrdersModule sharing single ownership scope
}
create system
object "module1 : OrdersModule" as module1 ownedBy system
event moduleRequest on system : Resolve OrdersModule
create module1
module1 --> system : returns module1
moduleRequest ..> system.module

lifetime "Request" as request from system {
	install module1 as OrdersModule
}
create request
object "orders1 : Orders" as orders1 ownedBy request
event ordersRequest on request : Resolve IOrders
create orders1
orders1 --> request : returns orders1
ordersRequest ..> request.module1.orders

destroy orders1
destroy request
@endautofac
