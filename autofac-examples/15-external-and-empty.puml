@startautofac
' Pre-existing external objects are not created by a request alias.
' An empty collection can be declared successful without inventing registrations.
composition "15 - External ownership and successful emptiness" {
	instance clock: FixedClock owner external
	lifetime system root {
		register clockBinding: IClock instance clock ownership external
	}

	resolve time: IClock from system
	expect time success {
		selected system.clockBinding
		instance clock
		state reused
		owner external
	}
	resolve plugins: IEnumerable<IPlugin> from system
	expect plugins success {
		empty
		message "This authored plugin set is intentionally empty"
	}

	dispose system
	expand time trace
	expand plugins
}
@endautofac
